# Copy to .env (git-ignored). On the server ansible writes .env from ansible/secrets.env.

# Signs all tokens. At least 32 characters, e.g.: openssl rand -base64 48
# Changing it logs out every app - they register again on their own.
JWT_SECRET=

# App Attest: "development" for builds from Xcode, "production" for TestFlight/App Store
APP_ATTEST_ENV=development

# Play Integrity: Google Cloud service account (JSON key file). Without it Android cannot register.
GOOGLE_SERVICE_ACCOUNT_FILE=
# true only while testing sideloaded Android builds
PLAY_ACCEPT_UNRECOGNIZED=false

# Only for a local server: lets simulators/emulators register without attestation.
DEBUG_ATTESTATION_TOKEN=

# Defaults: HOST=127.0.0.1, PORT=8080, APPLE_TEAM_ID=U74C75726B,
# APPLE_BUNDLE_ID=de.freegroup.candle, ANDROID_PACKAGE=de.freegroup.candle.app
