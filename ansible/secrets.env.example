# Copy to ansible/secrets.env (git-ignored). 02_playbook_deploy.yaml copies it to
# /home/candle/candle/server/.env - it is the only state of the server.

# openssl rand -base64 48 - a new value logs out every app; they re-register on their own
JWT_SECRET=

# App Attest environments accepted, comma-separated: "development" for builds
# from Xcode, "production" for TestFlight and the App Store. Both, to test from
# Xcode and TestFlight at the same time; only this team's app passes either way.
APP_ATTEST_ENV=development,production

# Written by the playbook if ansible/google-service-account.json exists
GOOGLE_SERVICE_ACCOUNT_FILE=/home/candle/google-service-account.json
PLAY_ACCEPT_UNRECOGNIZED=false

# SHA-256 of the debug signing certificates of our own builds (comma-separated,
# hex with colons as `keytool -list -v -keystore ~/.android/debug.keystore` prints
# them). Such a build passes Play Integrity on a real device although it is not
# from Google Play. Not a secret: the same values are in docs/.well-known/assetlinks.json.
PLAY_DEBUG_CERTIFICATES=5F:BF:8E:9E:D0:52:95:A0:71:D1:00:C0:CB:C5:4E:15:27:9D:E9:05:B3:18:BE:A1:9B:86:5E:89:77:6A:44:05
