# Managed by ansible - changes on the server are overwritten.

# The places endpoint answers registered apps only, but anyone can try: at most
# 5 queries per second per address (bursts of 20, e.g. a radar plus several
# explore categories behind one mobile network address).
limit_req_zone $binary_remote_addr zone=places:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name {{ candle_domain }};

    # certbot --webroot answers the ACME challenge from here
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

{% if has_certificate %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ candle_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ candle_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ candle_domain }}/privkey.pem;
{% endif %}

    location /v1/overpass {
        limit_req zone=places burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
